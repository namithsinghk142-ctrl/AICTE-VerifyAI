# ==============================================================================
# AICTE VerifyAI — Root Environment Configuration Template
# ==============================================================================

# Backend API Base URL for Vite Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Google OAuth Client ID for Frontend Web SDK
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend Configuration (see backend/.env.example for full details)
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./verifyai.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Google OAuth (Backend)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173

# Approved Reviewer Allowlist
APPROVED_EMAILS=adhav.sri123@gmail.com,namithsceptile142@gmail.com

