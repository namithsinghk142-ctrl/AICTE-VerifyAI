# ==============================================================================
# AICTE VerifyAI — Environment Configuration Template
# ==============================================================================

# Environment
APP_ENV=development
APP_DEBUG=true

# Server
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=sqlite:///./verifyai.db

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# Application Metadata
APP_TITLE=AICTE VerifyAI
APP_VERSION=0.6.0

# Document Storage & Upload Limits (bytes)
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=10485760

# OCR Engine (Optional custom binary path for Windows, e.g., C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=

# ------------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect (Phase 7 - Secure Authentication)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173

# Frontend client-side environment variable (Vite prefix)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Administrator-Controlled Allowlist
# ------------------------------------------------------------------------------
# Comma-separated list of normalized lowercase emails approved for system access.
# Only accounts on this list can establish an authenticated session.
APPROVED_EMAILS=adhav.sri123@gmail.com,namithsceptile142@gmail.com

# ------------------------------------------------------------------------------
# Session Security & Tokens
# ------------------------------------------------------------------------------
TOKEN_SECRET=sih-verifyai-dev-secret-do-not-use-in-production-2026
TOKEN_TTL_SECONDS=28800
# Set to 'true' in production (Render) so SameSite=None and Secure cookies work cross-site
VERIFYAI_SECURE_COOKIE=false

# ------------------------------------------------------------------------------
# Reviewer Accounts & Seed Credentials
# ------------------------------------------------------------------------------
# Reviewer 1 (Adhavan S — SIH Judge Demo Account, pre-filled on login page)
VERIFYAI_ADHAV_EMAIL=adhav.sri123@gmail.com
VERIFYAI_ADHAV_PASSWORD=VerifyAI@Adhav123!

# Reviewer 2 (Namith Singh — Review Officer personal account)
VERIFYAI_NAMITH_EMAIL=namithsceptile142@gmail.com
VERIFYAI_NAMITH_PASSWORD=VerifyAI@Namith123!
